-- ---------- step tracker ----------
local N = #CONFIG.StepNames
local LEFT, RIGHT, CY = 34, 426, 164
local gap = (RIGHT - LEFT) / (N - 1)
local circles, checks, lineFills, popScales = {}, {}, {}, {}

