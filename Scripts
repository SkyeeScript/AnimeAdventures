-- ---------- real loading flow ----------
local t0 = os.clock()
local function stamp() return string.format("+%.1fs", os.clock() - t0) end

local function runStep(i, label, work)
	if not gui.Parent then return false end
	setActive(i)
	local row = addRow(label, "task")
	local s = os.clock()
	-- steps 1..N-1 use CONFIG.StepTimes; the last step uses whatever time is left
	local minTime = CONFIG.StepTimes[i] or 5
	if i == N then
		minTime = math.max(5, CONFIG.TotalTime - (s - t0) - 0.6)
	end
	work()
	local rem = minTime - (os.clock() - s)
	if rem > 0 then task.wait(rem) end
	if not gui.Parent then return false end
	row.done(stamp())
	setDone(i)
	return true
end

