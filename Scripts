local spinners = {}

local function addRow(msg, kind)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, 24)
	row.BackgroundTransparency = 1
	row.Parent = rows

	local ic = text(row, kind == "info" and "ⓘ" or "↻", 15, UDim2.fromOffset(16, 0), 22, kind == "info" and DIM or GREEN, Enum.Font.GothamBold, Enum.TextXAlignment.Center)
	local tx = text(row, msg, 13, UDim2.fromOffset(46, 0), 290, Color3.fromRGB(200, 204, 218))
	local tm = text(row, "", 12, UDim2.fromOffset(334, 1), 70, DIM, Enum.Font.Gotham, Enum.TextXAlignment.Right)

	for _, o in ipairs({ ic, tx }) do
		local target = o.TextTransparency
		o.TextTransparency = 1
		TweenService:Create(o, TweenInfo.new(0.3), { TextTransparency = target }):Play()
	end

	if kind == "task" then table.insert(spinners, ic) end

	return {
		done = function(stamp, green)
			local i = table.find(spinners, ic)
			if i then table.remove(spinners, i) end
			ic.Rotation = 0
			ic.Text = "✓"
			ic.TextColor3 = GREEN
			if green then tx.TextColor3 = GREEN end
			tm.Text = stamp
		end,
		stamp = function(stamp) tm.Text = stamp end,
	}
end

-- ---------- animation loop (spinners + active step pulse) ----------
local activeStep = nil
local conn
conn = RunService.Heartbeat:Connect(function()
	if not gui.Parent then conn:Disconnect() return end
	local t = os.clock()
	for _, sp in ipairs(spinners) do
		sp.Rotation = (t * 360) % 360
	end
	if activeStep then
		popScales[activeStep].Scale = 1 + 0.08 * math.sin(t * 6)
	end
end)

local function setActive(i)
	activeStep = i
	circles[i].stroke.Color = GREEN
end

local function setDone(i)
	if activeStep == i then activeStep = nil end
	local c = circles[i]
	popScales[i].Scale = 1
	c.stroke.Color = GREEN
	TweenService:Create(c.frame, TweenInfo.new(0.25), { BackgroundColor3 = Color3.fromRGB(24, 52, 42) }):Play()
	checks[i].TextTransparency = 0
	local pop = Instance.new("UIScale")
	pop.Scale = 0.3
	pop.Parent = checks[i]
	TweenService:Create(pop, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	if lineFills[i] then
		TweenService:Create(lineFills[i], TweenInfo.new(0.5, Enum.EasingStyle.Quad), { Size = UDim2.fromScale(1, 1) }):Play()
	end
end

