	line.Size = UDim2.fromOffset(x2 - x1, 2)
	line.Position = UDim2.fromOffset(x1, CY - 1)
	line.BackgroundColor3 = GRAY
	line.BorderSizePixel = 0
	line.Parent = card
	local fillF = Instance.new("Frame")
	fillF.Size = UDim2.fromScale(0, 1)
	fillF.BackgroundColor3 = GREEN
	fillF.BorderSizePixel = 0
	fillF.Parent = line
	lineFills[i] = fillF
end

for i = 1, N do
	local cx = LEFT + (i - 1) * gap
	local c = Instance.new("Frame")
	c.Size = UDim2.fromOffset(30, 30)
	c.Position = UDim2.fromOffset(cx - 15, CY - 15)
	c.BackgroundColor3 = BG
	c.Parent = card
	corner(c, 15)
	local s = stroke(c, GRAY, 2)
	circles[i] = { frame = c, stroke = s }

	local sc = Instance.new("UIScale")
	sc.Parent = c
	popScales[i] = sc

	local chk = Instance.new("TextLabel")
	chk.Size = UDim2.fromScale(1, 1)
	chk.BackgroundTransparency = 1
	chk.Text = "✓"
	chk.TextColor3 = GREEN
	chk.TextSize = 18
	chk.Font = Enum.Font.GothamBold
	chk.TextTransparency = 1
